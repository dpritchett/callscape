#!/usr/bin/env bash
#
# Everything that depends on the repo and not on the session. Runs once, at
# create time, where a prebuild would cache it.
#
# Deliberately not here: the graph. `make sample` clones cli/cli and dumps it,
# which is the slow step and the one thing the page can wait for live — so it
# runs in `fly`, alongside the server, rather than holding the Codespace shut
# until it finishes. The page says it is waiting and picks the graph up without
# a reload, which is the first-run experience this project already has.
set -euo pipefail

cd "$(dirname "$0")/.."

# `make logs` pipes through jq, and make itself is not in every base image.
sudo apt-get update -qq
sudo apt-get install -y -qq --no-install-recommends make jq

npm --prefix web ci

# Warm the module cache and build the dumper. The built binary is what the
# source panel's lexer uses; without it every Tab press pays for `go run`.
go mod download
go build -o callscape-dump ./cmd/callscape-dump

echo "setup done — the server and the sample graph start on attach"
